#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"
PY="${PY:-.venv/bin/python}"

if [[ ! -x "$PY" ]]; then
  echo "missing Python: $PY" >&2
  echo "run: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

exec "$PY" -m stream_sieve.launcher "$@"
